@page "/queue"
@using Castle.Core.Services
@using Castle.Core.Models
@inject PlaybackService Player
@inject QueueService QueueService

<h3><LiListOrdered Size="20" Stroke="#BBBBBB" /> QUEUE</h3>

@if (_songs.Count == 0)
{
    <div class="empty-state">
        <LiListMusic Size="48" Stroke="#555" />
        <h3>Queue is empty</h3>
        <p class="status-text">Play some music to see your queue here.</p>
    </div>
}
else
{
    <ul class="song-list">
        @for (int i = 0; i < _songs.Count; i++)
        {
            var song = _songs[i];
            var isActive = i == QueueService.CurrentIndex;
            <li @onclick="() => PlayFromQueue(i)" 
                class="@(isActive ? "active" : "")">
                <span class="queue-index">@(i + 1)</span>
                @if (!string.IsNullOrEmpty(song.CoverArtPath))
                {
                    <img src="@GetCoverUrl(song.CoverArtPath)" class="song-cover" />
                }
                else
                {
                    <span class="song-cover-placeholder">🎵</span>
                }
                <span class="song-info">
                    <span class="song-title">@song.Title</span>
                    <span class="song-artist">@song.Artist</span>
                </span>
                <span class="song-duration">@FormatDuration(song.Duration)</span>
                @if (!isActive)
                {
                    <button @onclick="() => RemoveFromQueue(i)" 
                            @onclick:stopPropagation="true" 
                            class="playlist-remove-btn" title="Remove from queue">
                        <LiX Size="14" Stroke="#ff4444" />
                    </button>
                }
                else
                {
                    <span style="color: var(--accent); font-size: 14px;">🔊</span>
                }
            </li>
        }
    </ul>
}

@code {
    private List<Song> _songs = new();

    protected override void OnInitialized()
    {
        LoadQueue();
        QueueService.QueueChanged += OnQueueChanged;
    }

    void OnQueueChanged()
    {
        LoadQueue();
        InvokeAsync(StateHasChanged);
    }

    void LoadQueue()
    {
        _songs = QueueService.GetAll();
    }

    void PlayFromQueue(int index)
    {
        Player.PlayQueue(_songs, index);
    }

    void RemoveFromQueue(int index)
    {
        QueueService.RemoveAt(index);
        LoadQueue();
    }

    private string GetCoverUrl(string? path)
{
    return CoverArtService.GetCoverUrl(path);
}

    string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return string.Format("{0}:{1:D2}:{2:D2}", (int)duration.TotalHours, duration.Minutes, duration.Seconds);
        return string.Format("{0}:{1:D2}", duration.Minutes, duration.Seconds);
    }
}