@page "/updates"
@using Castle.Services
@inject UpdateService UpdateChecker

<div class="updates-page">
    <h2>Castle Updates</h2>
    <p class="status-text">Check if a newer version of Castle is available.</p>

    <div class="updates-card">
        <div class="updates-row">
            <span>Current Version</span>
            <strong>@AppVersion.Current</strong>
        </div>

        @if (_checking)
        {
            <p class="status-text">Checking for updates...</p>
        }
        else if (_updateInfo == null && _checked)
        {
            <div class="updates-current">
                <strong>Could not check for updates.</strong>
                <p>
                    Make sure the GitHub repository has a public release.
                    Private repositories will not work without authentication.
                </p>
            </div>
        }
        else if (_updateInfo != null)
        {
            <div class="updates-row">
                <span>Latest Version</span>
                <strong>@_updateInfo.LatestVersion</strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(_updateInfo.ReleaseName))
            {
                <div class="updates-row">
                    <span>Release</span>
                    <strong>@_updateInfo.ReleaseName</strong>
                </div>
            }

            @if (_updateInfo.IsUpdateAvailable)
            {
                <div class="updates-available">
                    <strong>New update available.</strong>
                    <p>Download the latest Castle installer from GitHub Releases.</p>

                    <button class="updates-btn" @onclick="OpenUpdate">
                        Download Update
                    </button>
                </div>
            }
            else
            {
                <div class="updates-current">
                    <strong>Castle is up to date.</strong>
                    <p>You are already using the latest version.</p>
                </div>
            }
        }

        <button class="updates-btn secondary" @onclick="CheckUpdates" disabled="@_checking">
            @(_checking ? "Checking..." : "Check for Updates")
        </button>
    </div>
</div>

@code {
    private bool _checking;
    private bool _checked;
    private UpdateInfo? _updateInfo;

    protected override async Task OnInitializedAsync()
    {
        await CheckUpdates();
    }

    private async Task CheckUpdates()
    {
        _checking = true;
        _checked = false;

        _updateInfo = await UpdateChecker.CheckForUpdatesAsync();

        _checking = false;
        _checked = true;
    }

    private async Task OpenUpdate()
    {
        if (_updateInfo == null)
        {
            return;
        }

        var url = !string.IsNullOrWhiteSpace(_updateInfo.InstallerDownloadUrl)
            ? _updateInfo.InstallerDownloadUrl
            : _updateInfo.ReleaseUrl;

        if (string.IsNullOrWhiteSpace(url))
        {
            return;
        }

        await Launcher.OpenAsync(url);
    }
}