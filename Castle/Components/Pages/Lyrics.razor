@page "/lyrics"
@using Castle.Core.Models
@using Castle.Core.Services
@using System.Timers
@implements IDisposable
@inject PlaybackService Player
@inject QueueService Queue
@inject IJSRuntime JS

<h3><LiMusic Size="20" Stroke="#BBBBBB" /> LYRICS</h3>

@if (Queue.CurrentSong == null)
{
    <div class="empty-state">
        <LiMusic Size="48" Stroke="#555" />
        <h3>No song playing</h3>
        <p class="status-text">Play a song to see its lyrics here.</p>
    </div>
}
else
{
    <div class="lyrics-now-playing">
        <strong>@Queue.CurrentSong.Title</strong>
        <span class="player-artist"> — @Queue.CurrentSong.Artist</span>
    </div>

    @if (_isLoading)
    {
        <p class="status-text">Loading lyrics...</p>
    }
    else if (_lyrics.Count == 0)
    {
        <div class="empty-state">
            <LiFileText Size="48" Stroke="#555" />
            <h3>No lyrics found</h3>
            <p class="status-text">Lyrics aren't available for this song.</p>
        </div>
    }
    else if (_hasTimestamps)
    {
        <div class="lyrics-scroll-container" @ref="_scrollContainer">
            <div class="lyrics-spacer" style="height: 40vh;"></div>
            @for (int i = 0; i < _lyrics.Count; i++)
            {
                var line = _lyrics[i];
                var isActive = i == _activeLineIndex;
                var isPast = i < _activeLineIndex;
                <div class="lyric-line-wrapper @(isActive ? "active" : "") @(isPast ? "past" : "")"
                     style="transition-delay: @(isActive ? "0s" : "0.1s")">
                    <p class="lyric-line @(isActive ? "active-text" : "")">@line.Text</p>
                </div>
            }
            <div class="lyrics-spacer" style="height: 40vh;"></div>
        </div>
    }
    else
    {
        <div class="lyrics-scroll-container">
            <div class="lyrics-spacer" style="height: 40vh;"></div>
            @foreach (var line in _lyrics)
            {
                <div class="lyric-line-wrapper">
                    <p class="lyric-line plain-text">@line.Text</p>
                </div>
            }
            <div class="lyrics-spacer" style="height: 40vh;"></div>
        </div>
    }
}

@code {
    private List<LyricLine> _lyrics = new();
    private double _currentPosition;
    private bool _isLoading;
    private bool _hasTimestamps;
    private System.Timers.Timer? _timer;
    private string _lastSongId = string.Empty;
    private int _activeLineIndex = -1;
    private ElementReference _scrollContainer;

    protected override void OnInitialized()
    {
        Player.LyricsLoaded += OnLyricsLoaded;
        Queue.QueueChanged += OnQueueChanged;
        Player.StateChanged += OnStateChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _timer = new System.Timers.Timer(100);
            _timer.Elapsed += async (_, _) =>
            {
                await UpdatePosition();
            };
            _timer.AutoReset = true;
            _timer.Start();

            if (Queue.CurrentSong != null)
            {
                LoadCurrentLyrics();
            }
        }
    }

    async Task UpdatePosition()
    {
        if (!_hasTimestamps || _lyrics.Count == 0) return;

        _currentPosition = Player.GetPosition();
        
        // Find the active lyric line based on timestamp
        var newActiveIndex = -1;
        for (int i = _lyrics.Count - 1; i >= 0; i--)
        {
            if (_currentPosition >= _lyrics[i].Timestamp.TotalSeconds)
            {
                newActiveIndex = i;
                break;
            }
        }

        if (newActiveIndex != _activeLineIndex)
        {
            _activeLineIndex = newActiveIndex;
            await InvokeAsync(StateHasChanged);
            
            // Smooth scroll to active line
            if (_activeLineIndex >= 0)
            {
                await JS.InvokeVoidAsync("castleLyrics.scrollToLine", _scrollContainer);
            }
        }
    }

    async void OnQueueChanged()
    {
        await InvokeAsync(LoadCurrentLyrics);
    }

    async void OnStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    void OnLyricsLoaded()
    {
        InvokeAsync(() =>
        {
            if (Queue.CurrentSong != null && Player.CurrentLyrics != null)
            {
                UpdateLyricsFromPlayer();
            }
        });
    }

    void LoadCurrentLyrics()
    {
        if (Queue.CurrentSong == null) return;
        if (Queue.CurrentSong.Id == _lastSongId && _lyrics.Count > 0) return;

        _lastSongId = Queue.CurrentSong.Id;
        _activeLineIndex = -1;
        _lyrics.Clear();
        _hasTimestamps = false;

        if (Player.CurrentLyrics != null && Player.CurrentLyrics.Count > 0)
        {
            UpdateLyricsFromPlayer();
            return;
        }

        _isLoading = true;
        StateHasChanged();
    }

    void UpdateLyricsFromPlayer()
    {
        if (Player.CurrentLyrics == null) return;
        
        _lyrics = Player.CurrentLyrics;
        _hasTimestamps = Player.CurrentLyrics.Any(l => l.Timestamp > TimeSpan.Zero);
        _isLoading = false;
        _lastSongId = Queue.CurrentSong?.Id ?? string.Empty;
        _activeLineIndex = -1;
        StateHasChanged();
    }

    public void Dispose()
    {
        Player.LyricsLoaded -= OnLyricsLoaded;
        Queue.QueueChanged -= OnQueueChanged;
        Player.StateChanged -= OnStateChanged;
        _timer?.Stop();
        _timer?.Dispose();
    }
}