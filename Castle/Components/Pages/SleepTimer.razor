@page "/sleeptimer"
@using Castle.Core.Services
@inject PlaybackService Player
@inject NavigationManager Navigation
@implements IDisposable

<div class="sleep-timer-page @(Player.SleepTimerActive ? "sleep-timer--active" : "")">
    <h3 class="sleep-timer__title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="pointer-events: none"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
        SLEEP TIMER
    </h3>

    @if (!Player.SleepTimerActive)
    {
        <p class="sleep-timer__subtitle">Drag the ring or tap a preset. Music stops when time's up.</p>
    }

    <div class="sleep-timer__ring-container">
        <svg class="sleep-timer__ring" viewBox="0 0 300 300"
             @onpointerdown="OnRingPointerDown"
             @onpointermove="OnRingPointerMove"
             @onpointerup="OnRingPointerUp"
             @onpointerleave="OnRingPointerUp">
            
            @* Background track *@
            <circle cx="150" cy="150" r="120"
                    fill="none"
                    stroke="var(--surface-hover)"
                    stroke-width="8" />
            
            @* Active arc *@
            <circle cx="150" cy="150" r="120"
                    fill="none"
                    stroke="var(--accent, #4DD7FF)"
                    stroke-width="8"
                    stroke-linecap="round"
                    stroke-dasharray="@GetDashArray()"
                    stroke-dashoffset="@GetDashOffset()"
                    transform="rotate(-90 150 150)"
                    style="transition: stroke-dasharray 0.3s cubic-bezier(0.4, 0, 0.2, 1)"
                    class="sleep-timer__arc" />
            
            @* Drag handle *@
            @if ((_isDragging || Player.SleepTimerActive) && _targetMinutes > 0)
            {
                <circle cx="@_handleX" cy="@_handleY" r="14"
                        fill="var(--accent, #4DD7FF)"
                        stroke="var(--bg-primary)"
                        stroke-width="3"
                        class="sleep-timer__handle"
                        style="filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3))" />
            }
        </svg>

        <div class="sleep-timer__center">
            @if (Player.SleepTimerActive)
            {
                <div class="sleep-timer__moon">
                    @GetMoonPhase()
                </div>
                <div class="sleep-timer__countdown">@FormatTimeRemaining()</div>
                <div class="sleep-timer__label">remaining</div>
            }
            else
            {
                <div class="sleep-timer__moon sleep-timer__moon--idle">🌑</div>
                <div class="sleep-timer__countdown">@FormatMinutes(_targetMinutes)</div>
                <div class="sleep-timer__label">minutes</div>
            }
        </div>
    </div>

    @if (!Player.SleepTimerActive)
    {
        <div class="sleep-timer__presets">
            <button @onclick="() => SnapToPreset(15)" class="sleep-timer__preset @(IsPresetActive(15) ? "sleep-timer__preset--active" : "")">
                <span class="preset-value">15</span>
                <span class="preset-label">min</span>
            </button>
            <button @onclick="() => SnapToPreset(30)" class="sleep-timer__preset @(IsPresetActive(30) ? "sleep-timer__preset--active" : "")">
                <span class="preset-value">30</span>
                <span class="preset-label">min</span>
            </button>
            <button @onclick="() => SnapToPreset(45)" class="sleep-timer__preset @(IsPresetActive(45) ? "sleep-timer__preset--active" : "")">
                <span class="preset-value">45</span>
                <span class="preset-label">min</span>
            </button>
            <button @onclick="() => SnapToPreset(60)" class="sleep-timer__preset @(IsPresetActive(60) ? "sleep-timer__preset--active" : "")">
                <span class="preset-value">1</span>
                <span class="preset-label">hour</span>
            </button>
            <button @onclick="() => SnapToPreset(120)" class="sleep-timer__preset @(IsPresetActive(120) ? "sleep-timer__preset--active" : "")">
                <span class="preset-value">2</span>
                <span class="preset-label">hours</span>
            </button>
        </div>

        <div class="sleep-timer__actions">
            <label class="sleep-timer__fade-toggle">
                <input type="checkbox" @bind="_fadeOutEnabled" />
                <span class="toggle-track">
                    <span class="toggle-thumb"></span>
                </span>
                <span class="toggle-label">Fade to sleep</span>
            </label>
            <button @onclick="StartTimer" class="sleep-timer__start-btn" disabled="@(_targetMinutes == 0)">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="pointer-events: none"><polygon points="5 3 19 12 5 21 5 3" /></svg>
                Start Timer
            </button>
        </div>
    }
    else
    {
        <div class="sleep-timer__actions">
            @if (_fadeOutEnabled && Player.SleepTimeRemaining.TotalSeconds <= 60 && Player.SleepTimeRemaining.TotalSeconds > 0)
            {
                <div class="sleep-timer__fade-indicator">
                    <span class="fade-dot"></span>
                    Fading out...
                </div>
            }
            <button @onclick="() => AddTime(15)" class="sleep-timer__adjust-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="pointer-events: none"><circle cx="12" cy="12" r="10" /><path d="M12 8v4l2 2" /></svg>
                +15 min
            </button>
            <button @onclick="CancelTimer" class="sleep-timer__cancel-btn">Cancel Timer</button>
        </div>
    }
</div>

@code {
    private int _targetMinutes = 15;
    private bool _isDragging;
    private bool _fadeOutEnabled = true;
    private double _handleX = 150;
    private double _handleY = 30;
    private System.Timers.Timer? _uiTimer;
    private float _originalVolume;
    private bool _fadeStarted;

    private const int MaxMinutes = 180;
    private const double Radius = 120;
    private const double CenterX = 150;
    private const double CenterY = 150;

    protected override void OnInitialized()
    {
        Player.SleepTimerChanged += OnTimerChanged;
        Player.SleepTimerEnded += OnTimerEnded;
        
        if (Player.SleepTimerActive)
        {
            StartUiTimer();
        }
        
        UpdateHandlePosition();
    }

    private void OnTimerChanged()
    {
        if (Player.SleepTimerActive && !_fadeStarted)
        {
            _originalVolume = Player.GetVolume();
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnTimerEnded()
    {
        _fadeStarted = false;
        _uiTimer?.Stop();
        InvokeAsync(StateHasChanged);
    }

    private void StartUiTimer()
    {
        _uiTimer?.Dispose();
        _uiTimer = new System.Timers.Timer(1000);
        _uiTimer.Elapsed += async (_, _) =>
        {
            if (Player.SleepTimerActive && Player.SleepTimeRemaining.TotalSeconds <= 60 && _fadeOutEnabled && !_fadeStarted)
            {
                _fadeStarted = true;
                _originalVolume = Player.GetVolume();
            }
            
            if (_fadeStarted && Player.SleepTimeRemaining.TotalSeconds > 0)
            {
                var progress = 1 - (Player.SleepTimeRemaining.TotalSeconds / 60.0);
                var volume = (float)(_originalVolume * (1 - progress));
                Player.SetVolume(volume);
            }
            
            UpdateHandlePosition();
            await InvokeAsync(StateHasChanged);
            
            if (!Player.SleepTimerActive)
            {
                if (_fadeStarted)
                {
                    Player.SetVolume(_originalVolume);
                    _fadeStarted = false;
                }
                _uiTimer?.Stop();
                await InvokeAsync(StateHasChanged);
            }
        };
        _uiTimer.AutoReset = true;
        _uiTimer.Start();
    }

    private void OnRingPointerDown(PointerEventArgs e)
    {
        if (Player.SleepTimerActive) return;
        _isDragging = true;
        UpdateFromPointer(e.OffsetX, e.OffsetY);
    }

    private void OnRingPointerMove(PointerEventArgs e)
    {
        if (!_isDragging || Player.SleepTimerActive) return;
        UpdateFromPointer(e.OffsetX, e.OffsetY);
    }

    private void OnRingPointerUp(PointerEventArgs e)
    {
        if (!_isDragging) return;
        _isDragging = false;
        
        // Snap to nearest 5 minutes
        _targetMinutes = Math.Max(1, (int)(Math.Round(_targetMinutes / 5.0) * 5));
        UpdateHandlePosition();
    }

    private void UpdateFromPointer(double offsetX, double offsetY)
    {
        var x = offsetX - CenterX;
        var y = offsetY - CenterY;
        
        var angle = Math.Atan2(y, x) * 180 / Math.PI;
        angle = (angle + 90) % 360;
        if (angle < 0) angle += 360;
        
        var fraction = angle / 360.0;
        _targetMinutes = Math.Max(1, (int)(fraction * MaxMinutes));
        
        UpdateHandlePosition();
    }

    private void UpdateHandlePosition()
    {
        double fraction;
        if (Player.SleepTimerActive)
        {
            var remaining = Player.SleepTimeRemaining.TotalMinutes;
            fraction = 1 - (remaining / MaxMinutes);
        }
        else
        {
            fraction = _targetMinutes / (double)MaxMinutes;
        }
        fraction = Math.Clamp(fraction, 0, 1);
        
        var angle = fraction * 360 - 90;
        var radians = angle * Math.PI / 180;
        _handleX = CenterX + Radius * Math.Cos(radians);
        _handleY = CenterY + Radius * Math.Sin(radians);
    }

    private void SnapToPreset(int minutes)
    {
        _targetMinutes = minutes;
        UpdateHandlePosition();
    }

    private bool IsPresetActive(int minutes) => _targetMinutes == minutes;

    private string GetDashArray()
    {
        var circumference = 2 * Math.PI * Radius;
        double fraction;
        if (Player.SleepTimerActive)
        {
            fraction = Player.SleepTimeRemaining.TotalMinutes / MaxMinutes;
        }
        else
        {
            fraction = _targetMinutes / (double)MaxMinutes;
        }
        fraction = Math.Clamp(fraction, 0, 1);
        var dashLength = circumference * fraction;
        return $"{dashLength:F1} {circumference - dashLength:F1}";
    }

    private string GetDashOffset()
    {
        var circumference = 2 * Math.PI * Radius;
        return $"{circumference * 0.25:F1}";
    }

    private string FormatMinutes(int minutes)
    {
        if (minutes >= 60)
            return $"{(int)(minutes / 60)}:{minutes % 60:D2}";
        return minutes.ToString();
    }

    private string FormatTimeRemaining()
    {
        var remaining = Player.SleepTimeRemaining;
        if (remaining.TotalHours >= 1)
            return $"{(int)remaining.TotalHours}h {remaining.Minutes:D2}m";
        if (remaining.TotalSeconds < 60)
            return $"{remaining.Seconds}s";
        return $"{remaining.Minutes}m {remaining.Seconds:D2}s";
    }

    private string GetMoonPhase()
    {
        if (!Player.SleepTimerActive) return "🌑";
        
        var remaining = Player.SleepTimeRemaining;
        var total = TimeSpan.FromMinutes(MaxMinutes);
        if (total == TimeSpan.Zero) return "🌑";
        
        var progress = remaining.TotalMinutes / total.TotalMinutes;
        return progress switch
        {
            > 0.75 => "🌑",
            > 0.5 => "🌒",
            > 0.25 => "🌓",
            > 0.0 => "🌔",
            _ => "🌕"
        };
    }

    private void StartTimer()
    {
        if (_targetMinutes <= 0) return;
        _fadeStarted = false;
        Player.SetSleepTimer(_targetMinutes);
        StartUiTimer();
    }

    private void AddTime(int minutes)
    {
        if (!Player.SleepTimerActive) return;
        var remaining = Player.SleepTimeRemaining.TotalMinutes + minutes;
        _targetMinutes = (int)Math.Min(remaining, MaxMinutes);
        Player.SetSleepTimer((int)remaining);
    }

    private void CancelTimer()
    {
        if (_fadeStarted)
        {
            Player.SetVolume(_originalVolume);
            _fadeStarted = false;
        }
        Player.CancelSleepTimer();
        _uiTimer?.Stop();
    }

    public void Dispose()
    {
        Player.SleepTimerChanged -= OnTimerChanged;
        Player.SleepTimerEnded -= OnTimerEnded;
        _uiTimer?.Dispose();
    }
}